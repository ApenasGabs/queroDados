# ─── Supabase ────────────────────────────────────────────────────────────────
# Required for the Crawlee hybrid scraper (scrapers/zapCrawleeHybrid.js).
# Find these values in your Supabase project: Settings → API.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ─── ZAP scraper options (optional) ─────────────────────────────────────────

# Stop scraping once the last listing price on a page exceeds this value (BRL).
# Leave empty or set to 0 for no limit.
ZAP_MAX_PRICE=

# Maximum number of listing pages to process per run.
# Leave empty or set to 0 for no limit.
ZAP_MAX_PAGES=

# Set to "false" to run Puppeteer with a visible browser window.
# Useful for local debugging on a machine with a GUI.
# Default: true (headless)
ZAP_HEADLESS=true
